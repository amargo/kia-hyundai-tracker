# UVO/Bluelink API credentials
UVO_USERNAME=your.email@example.com
UVO_PASSWORD=your-kia-password
UVO_VEHICLE_UUID=your-vehicle-uuid
UVO_PIN=1234
UVO_KIA_LANGUAGE=en  # language for the UVO/Bluelink API (default: en)

# Database configuration
# For MySQL (optional)
UVO_DB_HOST=localhost
UVO_DB_USER=uvo
UVO_DB_PASSWORD=your-db-password
UVO_DB_NAME=uvo

# HTTP server configuration
# When set, every http_server.py endpoint requires this token, either as
# "Authorization: Bearer <token>", "X-Api-Key: <token>", or "?password=<token>".
# Leave unset only if the server is never reachable outside a trusted network -
# /charge can start or stop charging with no other protection.
HTTP_SERVER_PASSWORD=your-http-server-password

# Debug modes
DEBUG=false      # Detailed logging
FLASK_DEBUG=false  # Flask development server debug mode - do not enable on a reachable host

# Refresh configuration
REFRESH_START_HOUR=7
REFRESH_END_HOUR=22
REFRESH_INTERVAL_MINUTES=30
MIN_AUX_BATTERY_SOC=80

# Timezone used both by the background scheduler and by the tracker's own day-boundary
# decisions (skipping "today" when saving daily stats)
UVO_TRACKER_TIMEZONE=Europe/Budapest
